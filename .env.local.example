# Copy this file to .env.local and fill in your values.

SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-key

# Keep this true to develop without a Twilio account.
# Outbound SMS will be logged to the console instead of sent.
MOCK_TWILIO=true

# Only needed once MOCK_TWILIO is not "true":
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=          # also used to validate inbound webhook signatures
#
# Optional: set to the public base URL Twilio calls (e.g. https://app.example.com)
# when running behind a proxy/tunnel where the request URL differs. If unset,
# the forwarded host/proto headers (or the request URL) are used.
# TWILIO_WEBHOOK_BASE_URL=
